# mnemond.conf -- Configuration for mnemond daemon
#
# Config search path:
#   1. --config <path>  (command line)
#   2. $XDG_CONFIG_HOME/mnemond/mnemond.conf
#   3. ~/.config/mnemond/mnemond.conf
#   4. SYSCONFDIR/mnemond.conf  (compiled-in, e.g., ~/.local/etc/mnemond/)
#   5. /etc/mnemond/mnemond.conf
#
# Missing config is not an error -- all settings have sane defaults.

[general]
data_dir = ~/.local/share/mnemond
log_level = info                    # debug, info, warn, error
foreground = false

[lmdb]
map_size_gb = 10                    # Maximum database size (virtual, not pre-allocated)
max_readers = 64

[embedding]
model_path = ~/.local/share/mnemond/models/nomic-embed-text-v1.5.Q8_0.gguf
dimensions = 768
batch_size = 32                     # Batch size for consolidation/bulk ops
gpu_layers = 99                     # Layers to offload to GPU (99 = all if GPU available)
model_sha256 =                      # Optional SHA-256 hash for model integrity verification

[extraction]
enabled = false
endpoint = http://127.0.0.1:8080/v1/chat/completions
timeout_ms = 10000
model =                             # Empty = use server default

[search]
default_top_k = 10
max_top_k = 50
rrf_k = 60                         # RRF constant (standard value from literature)

[consolidation]
threshold = 100                     # Unconsolidated memories before auto-trigger
interval_sec = 3600                 # Periodic consolidation interval
similarity_threshold = 0.7         # Cosine similarity for clustering

[decay]
half_life_days = 90                 # Importance halves without access
min_importance = 0.01               # Below this, eligible for pruning

[import]
allowed_paths = ~                   # Directories import_file/import_directory can read from
max_batch_size = 1000               # Max memories per import_batch call
default_chunk_size = 4096           # Default max chars per chunk
writer_batch_size = 50              # Memories per writer queue submission (avoids blocking)

[security]
detect_secrets = true
max_memory_size_kb = 64             # Reject memories larger than this

[threads]
reader_pool_size = 0                # 0 = auto (min(nproc, 16))
write_queue_depth = 1024

[http]
enabled = false
bind = 127.0.0.1
port = 3847
max_connections = 32
connection_timeout = 120            # Seconds of idle before MHD reaps a connection.
                                    # 0 = no timeout (NOT recommended -- dead clients
                                    # can leak connections until max_connections fills).
                                    # SO_KEEPALIVE is also enabled per-socket so the
                                    # kernel detects half-open peers within ~2 minutes.
per_ip_connection_limit = 0         # Max concurrent connections per client IP.
                                    # 0 = unlimited. Set to e.g. 8 to prevent a single
                                    # misbehaving client from consuming the whole pool.
session_idle_timeout = 1800         # Seconds of MCP session inactivity before reaping.
                                    # Most MCP clients never send DELETE on shutdown,
                                    # so without this, the 256-session table would
                                    # eventually fill from client restarts. Sessions
                                    # with an active SSE stream are protected.
                                    # 0 = disable (not recommended).
auth_token =                        # Optional Bearer token for HTTP auth
allow_ips =                         # Comma-separated CIDR allow list (empty = allow all)
                                    # Example: 192.168.1.0/24, 10.0.0.5, 172.16.0.0/12

[diag]
heartbeat_secs = 0                  # 0 = disabled. Set e.g. 60 to log
                                    # connection / in-flight / reader-pool gauges
                                    # at INFO every N seconds. Use SIGUSR1 for
                                    # an on-demand dump regardless of this setting.
